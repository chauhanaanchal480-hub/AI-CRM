# ─────────────────────────────────────────────────────────────
# Root environment example. Copy to `.env` for docker-compose,
# and see server/.env.example / web/.env.example for app-level vars.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (used by docker-compose)
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_DB=crm

# Required by the production API container. Generate independent values;
# JWT/cookie secrets must be at least 32 bytes and must all differ.
DATABASE_URL=
DATABASE_URL_ENCRYPTED=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEYS=
ENCRYPTION_CURRENT_KEY_ID=
FIELD_ENCRYPTION_ENABLED=true
FIELD_SEARCH_KEY=
MIGRATION_DATABASE_URL=
RETENTION_DATABASE_URL=
REDIS_ENABLED=true
# Use an independently generated URL-safe password (for example: openssl rand -base64 32 | tr '+/' '-_').
REDIS_PASSWORD=
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
REDIS_URL_ENCRYPTED=
REDIS_KEY_PREFIX=ai-crm
CACHE_DASHBOARD_TTL_SECONDS=60
CACHE_ANALYTICS_TTL_SECONDS=300
CACHE_ENTITY_TTL_SECONDS=120
CACHE_AI_TTL_SECONDS=900
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_WORKER_CONCURRENCY=5
QUEUE_JOB_TIMEOUT_MS=120000
EXPORT_BATCH_SIZE=500
EXPORT_DIR=exports
RESPONSE_COMPRESSION_THRESHOLD_BYTES=1024
BACKUP_DATABASE_URL=
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_ENCRYPTION_KEY=
API_HMAC_KEYS=
API_HMAC_REQUIRED=false
API_HMAC_CLOCK_SKEW_SECONDS=300
API_IDEMPOTENCY_TTL_HOURS=24
API_ABUSE_WINDOW_MS=300000
API_ABUSE_STRIKE_LIMIT=100
API_DOCS_ENABLED=false

# Provider keys may be plaintext secret-manager injections or encrypted
# AES-256-GCM envelopes. Encrypted values take precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_ENCRYPTED=
OPENAI_API_KEY=
OPENAI_API_KEY_ENCRYPTED=
GEMINI_API_KEY=
GEMINI_API_KEY_ENCRYPTED=

# Exposed ports
API_PORT=4000
WEB_PORT=5173
POSTGRES_PORT=5432

# API sliding-window limits (consumed by the api container)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=50000
RATE_LIMIT_GLOBAL_MAX=20000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=1000
RATE_LIMIT_IP_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=2000
RATE_LIMIT_USER_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=50
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_AI_MAX=100
RATE_LIMIT_AI_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=100
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_EXPORT_MAX=30
RATE_LIMIT_EXPORT_WINDOW_MS=3600000
