# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (local dev — matches docker-compose default)
DATABASE_URL=postgresql://crm:crm_password@localhost:5432/crm?schema=public
DATABASE_URL_ENCRYPTED=

# AES-256-GCM key ring: key-id=32-byte-base64url-key,old-id=old-key
# Generate independent 32-byte keys with: openssl rand -base64 32
ENCRYPTION_KEYS=
ENCRYPTION_CURRENT_KEY_ID=
FIELD_ENCRYPTION_ENABLED=true
# Dedicated 32-byte HMAC key for encrypted email search indexes.
FIELD_SEARCH_KEY=

# Database observability and retention
DB_QUERY_SLOW_MS=750
DB_QUERY_LOG_SAMPLE_RATE=0.01
DATA_RETENTION_ENABLED=true
RETENTION_DATABASE_URL=
DATA_RETENTION_INTERVAL_HOURS=24
SOFT_DELETE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=2555
AUTH_RETENTION_DAYS=730
RETENTION_RUN_RETENTION_DAYS=365

# Backups use a dedicated read-only role and key. These are consumed by the
# db:backup/db:restore commands and are never needed by the API process.
BACKUP_DATABASE_URL=
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=35

# Auth — generate strong secrets in production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
COOKIE_SECRET=dev_cookie_secret_change_me_2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Enterprise API security. Use comma-separated key-id=secret entries; each
# production HMAC secret must contain at least 32 bytes.
API_HMAC_KEYS=
API_HMAC_REQUIRED=false
API_HMAC_CLOCK_SKEW_SECONDS=300
API_IDEMPOTENCY_TTL_HOURS=24
API_ABUSE_WINDOW_MS=300000
API_ABUSE_STRIKE_LIMIT=100
API_DOCS_ENABLED=true

# Sliding-window abuse protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=50000
RATE_LIMIT_GLOBAL_MAX=20000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=1000
RATE_LIMIT_IP_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=2000
RATE_LIMIT_USER_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=50
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_AI_MAX=100
RATE_LIMIT_AI_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=100
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_EXPORT_MAX=30
RATE_LIMIT_EXPORT_WINDOW_MS=3600000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# AI provider: mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_ENCRYPTED=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_API_KEY_ENCRYPTED=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_API_KEY_ENCRYPTED=
GEMINI_MODEL=gemini-2.5-flash
